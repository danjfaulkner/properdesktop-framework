@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(ProperDesktopToolkit)

foreach(_component IN LISTS ProperDesktopClients_FIND_COMPONENTS)
    set(_targets "${CMAKE_CURRENT_LIST_DIR}/ProperDesktopClient${_component}Targets.cmake")
    if(EXISTS "${_targets}")
        include("${_targets}")
        set(ProperDesktopClients_${_component}_FOUND TRUE)
    else()
        set(ProperDesktopClients_${_component}_FOUND FALSE)
    endif()
    unset(_targets)
endforeach()

check_required_components(ProperDesktopClients)
